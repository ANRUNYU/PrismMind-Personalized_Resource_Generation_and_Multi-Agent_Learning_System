# Application
APP_NAME=棱镜智教-PrismMind
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
REQUEST_ID_HEADER=X-Request-ID

# Security
# Generate a strong value locally. Do not commit real secrets.
SECRET_KEY=change-me-to-a-strong-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Docker Compose uses the postgres service name. For host-local backend runs, use localhost instead:
# DATABASE_URL=postgresql+psycopg://edugenie_user:edugenie_password@localhost:5432/edugenie_dev
DATABASE_URL=postgresql+psycopg://edugenie_user:edugenie_password@postgres:5432/edugenie_dev

# Redis / Celery
# Docker Compose uses the redis service name. For host-local backend runs, use redis://127.0.0.1:6379/0.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_CELERY=true

# CORS
# JSON-array and comma-separated formats are both supported by app.core.config.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage / Chroma
STORAGE_ROOT=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.csv,.txt,.md
MAX_BATCH_UPLOAD_FILES=20
MAX_BATCH_UPLOAD_SIZE_MB=200
OCR_ENABLED=true
GENERATION_REFERENCE_WAIT_SECONDS=1800
GENERATION_REFERENCE_POLL_SECONDS=2
OCR_LANGUAGE=chi_sim+eng
PDF_TEXT_MIN_CHARS=20
OFFICE_CONVERSION_TIMEOUT_SECONDS=60
PARSE_STALE_AFTER_MINUTES=30
CHROMA_PERSIST_DIR=/app/storage/chroma
CHROMA_COLLECTION_NAME=edugenie_knowledge

# LLM providers
LLM_PROVIDER=mock
LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
QA_V2_MATCH_THRESHOLD=0.34
QA_V2_MAX_KEYPOINTS=20
QA_V2_MAX_GENERATED_SECTIONS=40
# Optional placeholders. Put real keys in backend/.env only; never commit them.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL_ORCHESTRATOR=qwen3.7-plus
AGENT_MODEL_PROFILE=qwen3.6-plus
AGENT_MODEL_TUTOR=qwen3-max
AGENT_MODEL_RESOURCE=qwen3-max
AGENT_MODEL_TEST=deepseek-v3
AGENT_MODEL_PATH=qwen3.7-plus
AGENT_MODEL_ASSESSMENT=qwen3-max
AGENT_MODEL_VERIFIER=qwen3.6-plus
AGENT_FALLBACK_MODEL_PROFILE=qwen3.7-plus
AGENT_FALLBACK_MODEL_TEST=qwen3-max
AGENT_FALLBACK_MODEL_PATH=qwen3-max
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_MAX_CONCURRENCY=4
CHROMA_COLLECTION_VERSION=te4_1024_v1
CHROMA_ACTIVE_COLLECTION=prismmind_knowledge_te4_1024_v1
CHROMA_LEGACY_COLLECTION=edugenie_knowledge
RERANK_MODEL=qwen3-rerank
RAG_RERANK_ENABLED=true
RAG_CANDIDATE_K=20
RAG_FINAL_K=5
RAG_MIN_TOP_SIMILARITY=0.45
RAG_MIN_MEAN_SIMILARITY=0.30
RAG_MIN_ACCEPTED_CHUNKS=1
RAG_RERANK_TIMEOUT_SECONDS=15
RAG_THRESHOLD_CALIBRATION_FILE=
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
LIVE_LLM_TESTS=false
ALLOW_MOCK_FALLBACK=false
AGENT_ENABLE_THINKING_PATH=true
AGENT_ENABLE_THINKING_TUTOR=false
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_CONCURRENCY=4
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_PER_RUN_TOKEN_BUDGET=32000
