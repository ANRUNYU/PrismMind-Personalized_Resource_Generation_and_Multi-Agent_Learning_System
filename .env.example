# Copy this file to .env for local Docker Compose usage.
# Never commit real credentials. Keep LLM_PROVIDER=mock when no private key is configured.
APP_NAME=棱镜智教-PrismMind
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Generate a unique value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-local-secret

POSTGRES_DB=edugenie_dev
POSTGRES_USER=edugenie_user
POSTGRES_PASSWORD=local-development-only-change-before-deployment

LLM_PROVIDER=mock
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
